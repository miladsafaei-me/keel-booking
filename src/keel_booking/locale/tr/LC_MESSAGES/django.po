"Your %(meeting)s with %(owner_name)s on %(date)s, %(time)s (%(zone)s) is "
"cancelled."
msgstr ""
"%(owner_name)s ile %(date)s, %(time)s (%(zone)s) tarihli %(meeting)s "
"görüşmeniz iptal edildi."

