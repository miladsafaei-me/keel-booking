msgstr "Görüşmeniz iptal edildi"

#, python-format
msgid ""
"Hi %(guest)s, the meeting below with %(owner_name)s is cancelled and has "
"been removed from the calendar."
msgstr ""
"Merhaba %(guest)s, %(owner_name)s ile aşağıdaki görüşmeniz iptal edildi ve "
"takvimden kaldırıldı."

