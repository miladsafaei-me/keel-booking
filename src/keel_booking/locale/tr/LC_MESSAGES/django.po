msgid "%(meeting)s starts at %(time)s."
msgstr "%(meeting)s başlıyor: saat %(time)s."

#, python-format
msgid "Starts in %(minutes)s minutes"
msgstr "%(minutes)s dakika sonra başlıyor"

#, python-format
msgid "Your meeting with %(owner_name)s starts soon"
msgstr "%(owner_name)s ile görüşmeniz birazdan başlıyor"

#, python-format
msgid ""
"Hi %(guest)s, this is a reminder that your %(meeting)s starts in %(minutes)s"
" minutes."
msgstr ""
"Merhaba %(guest)s, %(meeting)s görüşmenizin %(minutes)s dakika sonra "
"başlayacağını hatırlatırız."

#, python-format
msgid ""
"Hi %(guest)s, your %(meeting)s with %(owner_name)s starts in %(minutes)s "
"minutes."
msgstr ""
"Merhaba %(guest)s, %(owner_name)s ile %(meeting)s görüşmeniz %(minutes)s "
"dakika sonra başlıyor."

