msgstr "رزرو تأیید شد"

#, python-format
msgid "You are booked with %(owner_name)s"
msgstr "جلسه‌ی شما با %(owner_name)s رزرو شد"

#, python-format
msgid ""
"Hi %(guest)s, your %(meeting)s is confirmed. The details are below, and the "
"calendar file attached adds it to your calendar."
msgstr ""
"سلام %(guest)s، جلسه‌ی «%(meeting)s» شما تأیید شد. جزئیات را پایین‌تر "
"می‌بینید. فایل تقویم پیوست‌شده هم جلسه را به تقویم شما اضافه می‌کند."

msgid "View the booking"
msgstr "دیدن رزرو"

#, python-format
msgid ""
"Need to change the time? Reply to this email and %(owner_name)s will sort it"
" out. A reminder with the link arrives %(minutes)s minutes before the start."
msgstr ""
"اگر لازم است زمان را عوض کنید، به همین ایمیل پاسخ دهید تا %(owner_name)s "
"هماهنگ کند. یادآوری همراه با لینک جلسه %(minutes)s دقیقه پیش از شروع می‌رسد."

#, python-format
msgid "Your %(meeting)s with %(owner_name)s is confirmed."
msgstr "جلسه‌ی «%(meeting)s» شما با %(owner_name)s تأیید شد."

msgid "Timezone"
msgstr "منطقه‌ی زمانی"

#, python-format
msgid "%(meeting)s starts at %(time)s."
msgstr "%(meeting)s ساعت %(time)s شروع می‌شود."

#, python-format
msgid "Starts in %(minutes)s minutes"
msgstr "%(minutes)s دقیقه‌ی دیگر شروع می‌شود"

#, python-format
msgid "Your meeting with %(owner_name)s starts soon"
msgstr "جلسه‌ی شما با %(owner_name)s به‌زودی شروع می‌شود"

#, python-format
msgid ""
"Hi %(guest)s, this is a reminder that your %(meeting)s starts in %(minutes)s"
" minutes."
msgstr ""
"سلام %(guest)s، یادآوری می‌کنیم که جلسه‌ی «%(meeting)s» شما %(minutes)s "
"دقیقه‌ی دیگر شروع می‌شود."

#, python-format
msgid ""
"Hi %(guest)s, your %(meeting)s with %(owner_name)s starts in %(minutes)s "
"minutes."
msgstr ""
"سلام %(guest)s، جلسه‌ی «%(meeting)s» شما با %(owner_name)s %(minutes)s "
"دقیقه‌ی دیگر شروع می‌شود."

msgid "Join"
