#, python-format
msgid "Book a meeting with %(owner_name)s"
msgstr "رزرو جلسه با %(owner_name)s"

msgid "No meeting types are open right now."
msgstr "فعلاً هیچ جلسه‌ای برای رزرو باز نیست."

