msgid "{n} answers need your attention:"
msgstr "{n} مورد را باید اصلاح کنید:"

msgid "Checking"
msgstr "در حال بررسی"

msgid "Booking your session"
msgstr "در حال ثبت جلسه‌ی شما"

msgid "The booking did not go through. Please try again."
msgstr "رزرو انجام نشد. لطفاً دوباره تلاش کنید."

#, python-brace-format
msgid "You can attach up to {n} files."
msgstr "حداکثر {n} فایل می‌توانید پیوست کنید."

#, python-brace-format
msgid "{name}: this file type is not accepted."
msgstr "{name}: این نوع فایل پذیرفته نمی‌شود."

#, python-brace-format
msgid "{name} is larger than {mb} MB."
msgstr "حجم {name} بیشتر از {mb} مگابایت است."

#, python-brace-format
msgid "{day}, {start} to {end}"
msgstr "{day}، {start} تا {end}"

#, python-brace-format
msgid "You can add up to {n} profiles."
msgstr "حداکثر {n} پروفایل می‌توانید اضافه کنید."

msgid ""
"Please enter a Telegram ID, such as @name, or a number with the country code."
msgstr "لطفاً آیدی تلگرام مثل @name یا شماره با کد کشور را وارد کنید."

msgid ""
"Please enter a WhatsApp number with the country code, such as +90 555 123 "
"4567."
msgstr "لطفاً شماره‌ی واتس‌اپ را با کد کشور وارد کنید، مثل +90 555 123 4567."

msgid "Please enter your Telegram or WhatsApp, so I can reach you online."
msgstr ""
"لطفاً تلگرام یا واتس‌اپ خود را وارد کنید تا بتوانم آنلاین با شما در تماس "
"باشم."

msgid "Please pick one of the options."
msgstr "لطفاً یکی از گزینه‌ها را انتخاب کنید."

msgid "Please pick at least one option."
msgstr "لطفاً دست‌کم یک گزینه را انتخاب کنید."

msgid "Please pick an option."
msgstr "لطفاً یک گزینه انتخاب کنید."

msgid "Please fill this in."
msgstr "لطفاً این فیلد را پر کنید."

msgid "The form could not be read."
msgstr "فرم خوانده نشد."

msgid "Please enter your name."
msgstr "لطفاً نام خود را بنویسید."

msgid "Please enter your brand or company name."
msgstr "لطفاً نام برند یا شرکت خود را بنویسید."

msgid "Please enter your phone number."
msgstr "لطفاً شماره‌ی تلفن خود را بنویسید."

msgid "Please write a few words about what you need."
msgstr "لطفاً در چند جمله بنویسید چه چیزی لازم دارید."

msgid "Please add at least one social profile."
msgstr "لطفاً دست‌کم یک حساب شبکه‌ی اجتماعی اضافه کنید."

msgid "Please enter a phone number with digits only."
msgstr "لطفاً شماره‌ی تلفن را فقط با عدد وارد کنید."

msgid "Please enter your email address."
msgstr "لطفاً ایمیل خود را بنویسید."

msgid "Please enter a valid email address, such as name@company.com."
msgstr "لطفاً یک ایمیل درست بنویسید، مثل name@company.com."

#, python-brace-format
msgid "{email} is not a valid email address."
msgstr "{email} ایمیل معتبری نیست."

#, python-brace-format
msgid "You can add up to {n} guests."
msgstr "حداکثر {n} مهمان می‌توانید اضافه کنید."

msgid "Please pick a time."
msgstr "لطفاً یک زمان انتخاب کنید."

msgid "Too many bookings from this connection. Please try again later."
msgstr ""
"از این اتصال رزروهای زیادی ثبت شده است. لطفاً کمی بعد دوباره تلاش کنید."

msgid "That time was just taken. Please pick another one."
msgstr "این زمان همین حالا رزرو شد. لطفاً زمان دیگری انتخاب کنید."

