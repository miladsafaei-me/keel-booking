msgstr "جلسه‌ی شما لغو شد"

#, python-format
msgid ""
"Hi %(guest)s, the meeting below with %(owner_name)s is cancelled and has "
"been removed from the calendar."
msgstr ""
"سلام %(guest)s، جلسه‌ی زیر با %(owner_name)s لغو شد و از تقویم هم حذف شد."

msgid "Pick a new time"
msgstr "زمان تازه‌ای انتخاب کنید"

#, python-format
msgid "Hi %(guest)s,"
msgstr "سلام %(guest)s،"

#, python-format
msgid ""
"Your %(meeting)s with %(owner_name)s on %(date)s, %(time)s (%(zone)s) is "
"cancelled."
msgstr ""
"جلسه‌ی «%(meeting)s» شما با %(owner_name)s در %(date)s، ساعت %(time)s "
"(%(zone)s) لغو شد."

